{
  "name": "ale-coach-prenotazioni",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview --host 0.0.0.0",
    "local:start": "supabase start && node scripts/sync-local-env.mjs && node scripts/seed-local-users.mjs",
    "local:status": "supabase status",
    "local:stop": "supabase stop",
    "local:env": "node scripts/sync-local-env.mjs",
    "local:seed": "node scripts/seed-local-users.mjs",
    "local:reset": "supabase db reset && node scripts/seed-local-users.mjs",
    "local:check": "node --test scripts/*.test.mjs",
    "local:integration": "node scripts/local-integration.mjs",
    "release:check": "node scripts/release-check.mjs",
    "release:build": "npm run release:check && npm run build"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.76.0",
    "lucide-react": "^0.468.0",
    "qrcode": "^1.5.4",
    "react": "^19.2.0",
    "react-dom": "^19.2.0"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.1.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@types/qrcode": "^1.5.5",
    "tailwindcss": "^4.1.0",
    "typescript": "^5.9.0",
    "vite": "^7.2.0",
    "@vitejs/plugin-react": "^5.1.0",
    "supabase": "2.121.0"
  }
}
