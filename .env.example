# Pubbliche, caricate dal frontend Vite. NON inserire chiavi segrete qui.
# Il frontend si collega esclusivamente al progetto Supabase Cloud di Ale Coach.
# Configura queste variabili in Vercel: NON committare il loro valore qui.
VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=
VITE_VAPID_PUBLIC_KEY=
VITE_COACH_WHATSAPP=

# Abilitare SOLO dopo la configurazione di Google OAuth nel progetto Supabase.
VITE_GOOGLE_ENABLED=false

# Configurazione commerciale, SOLO variabili PUBBLICHE. Nessun segreto qui.
# Cloudflare Pages: usare npm run release:build dopo aver validato legalmente il sito.
VITE_PUBLIC_SITE_URL=
VITE_LEGAL_CONTROLLER_NAME=
VITE_LEGAL_CONTROLLER_ADDRESS=
VITE_LEGAL_CONTACT_EMAIL=
VITE_LEGAL_TAX_ID=
VITE_LEGAL_POLICY_VERSION=
# True SOLO dopo che un consulente/titolare ha finalizzato le informative.
VITE_LEGAL_APPROVED=false
